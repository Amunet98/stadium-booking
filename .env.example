# Copy to .env and adjust. .env is gitignored.
# These defaults are fine for a local demo and unfit for anything else.

WEB_PORT=8080

DB_NAME=booking
DB_USER=booking
DB_PASSWORD=bookingpw
MYSQL_ROOT_PASSWORD=rootpw

# development | production
# production turns off the demo-credentials hint on the login page.
APP_ENV=development

# ---------------------------------------------------------------------------
# Only needed when deploying. Local docker-compose needs none of these.
# ---------------------------------------------------------------------------

# Managed MySQL issues non-standard ports and requires TLS. DB_SSL_CA is a path
# to the provider's CA bundle; setting it turns on certificate verification.
# DB_PORT=3306
# DB_SSL_CA=/etc/ssl/mysql/ca.pem

# Set to 1 only when a proxy in front of the app terminates TLS and sets
# X-Forwarded-Proto — every PaaS does. Without it the app sees plain HTTP and
# emits http:// links on an https:// site. Leave unset anywhere the header is
# not guaranteed: it is trivially forged by a client.
# TRUST_PROXY=1

# Overrides the scheme+host used to build links. Usually unnecessary — the app
# derives it from the request — but useful behind a path-rewriting proxy.
# APP_BASE_URL=https://example.com

# The port the container listens on. Hosting platforms inject this; defaults
# to 80 so compose and `docker run -p 8080:80` work unchanged.
# PORT=80
