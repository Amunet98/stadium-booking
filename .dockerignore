# Only src/ is copied into the image; everything below would either bloat it or
# has no business being on a public server.

.git
.gitignore
.env

# The 2021 code. Preserved in the repo for the diff, never served.
legacy/

# ~2MB of screenshots and the findings write-up.
docs/

# Test scripts run against a deployment from outside it, not from within.
tests/

docker-compose.yml
Dockerfile
README.md

# db/ is deliberately NOT ignored — the entrypoint runs db/bootstrap.php to
# initialise a managed database on first boot, so schema.sql and seed.sql have
# to travel with the image. They land in /var/www/db, outside the docroot.
