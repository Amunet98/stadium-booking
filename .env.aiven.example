# Copy to .env.aiven and fill in from the Aiven console.
# .env.* is gitignored — this file is the only one that gets committed.
#
# Everything below is on the service's Overview page in Aiven, under
# "Connection information". Switch the dropdown to "MySQL" (not "mysql CLI").
#
# Region: Aiven's free tier only offers a broad continent — a specific cloud
# provider and region needs the Professional tier. Pick **North America**, which
# is the closest available to Render's `oregon` (AWS us-west-2, pinned in
# render.yaml). Neither side can be moved later without recreating the service.
#
# Note that a free Aiven service is powered off when idle, and Render's free
# tier sleeps too — so a visitor after a quiet period may wait on both. The
# nightly job in .github/workflows/demo-reset.yml connects daily and doubles as
# a keep-alive; raise its frequency if the database still powers down.

# Looks like: mysql-abc12345-yourproject.a.aivencloud.com
DB_HOST=

# Aiven does NOT use 3306 — it assigns a port per service, usually 5 digits.
DB_PORT=

# Aiven creates a database called `defaultdb`. You can use it as-is, or create
# one named `booking` in the Databases tab and put that here instead.
DB_NAME=defaultdb

# Aiven's superuser is `avnadmin`.
DB_USER=avnadmin

DB_PASSWORD=

# Download "CA Certificate" from the same Overview page and save it next to
# this file. Aiven requires TLS; without the CA the connection still encrypts
# but nothing verifies you are talking to the right server.
DB_SSL_CA=./ca.pem
